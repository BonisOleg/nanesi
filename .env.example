# Локальна розробка. Для Droplet: .env.docker.example → .env на сервері.
DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=nanesi
POSTGRES_USER=nanesi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://nanesi:change-me@db:5432/nanesi

CSRF_TRUSTED_ORIGINS=https://nanesi.example

ADMIN_URL=admin/

# Заповнюються пізніше (Етап E) — не блокують старт
NP_API_KEY=
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_CITY_REF=
NP_SENDER_ADDRESS_REF=
NP_SENDER_PHONE=

# Monobank Acquiring — токен з https://web.monobank.ua/ (або тест з https://api.monobank.ua/).
# Порожній = пункт «Оплата карткою» зникає з вітрини.
MONOBANK_TOKEN=
# Абсолютний URL webhook (прод). Локально можна лишити порожнім — підставиться request host.
MONOBANK_WEBHOOK_URL=https://nanesi.com.ua/payment/webhook/

# SalesDrive CRM (create/update заявок). Порожні = outbox лишається PENDING.
# Інструкція: _reference/SalesDrive-підключення.md
SALESDRIVE_API_URL=https://your-account.salesdrive.me
SALESDRIVE_API_KEY=
# Секрет у URL webhook: /webhooks/salesdrive/<SALESDRIVE_WEBHOOK_SECRET>/
SALESDRIVE_WEBHOOK_SECRET=

GA4_ID=
GTM_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
