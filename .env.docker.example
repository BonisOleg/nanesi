# DigitalOcean Droplet (.env на сервері, НЕ комітити)
# cp .env.docker.example .env && nano .env
# Обов'язково замінити DROPLET_IP на реальний IPv4 (не лишати літерал).

DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DEBUG=False

# HTTP-тест по IP: false. Після DNS+certbot → true і CSRF https://…
CANONICAL_HOST=nanesi.com.ua
USE_HTTPS=false
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

POSTGRES_DB=nanesi
POSTGRES_USER=nanesi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://nanesi:change-me-strong-password@db:5432/nanesi

# HTTP по IP: IP у ALLOWED_HOSTS. Після DNS+HTTPS:
# ALLOWED_HOSTS=nanesi.com.ua,www.nanesi.com.ua,46.101.212.242,127.0.0.1,localhost,backend,web
# CSRF_TRUSTED_ORIGINS=https://nanesi.com.ua,https://www.nanesi.com.ua
ALLOWED_HOSTS=DROPLET_IP,127.0.0.1,localhost,backend,web
CSRF_TRUSTED_ORIGINS=http://DROPLET_IP

ADMIN_URL=admin/

NP_API_KEY=
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_CITY_REF=
NP_SENDER_ADDRESS_REF=
NP_SENDER_PHONE=

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SERVER_URL=
LIQPAY_SANDBOX=True

# SalesDrive CRM
SALESDRIVE_API_URL=https://your-account.salesdrive.me
SALESDRIVE_API_KEY=
SALESDRIVE_WEBHOOK_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

GA4_ID=
GTM_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
